{
  "name": "foreca-cctv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Виртуальная CCTV-камера: недельный прогноз Foreca как RTSP-поток для видеорегистратора",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi:normalize": "tsx scripts/normalize-openapi.ts",
    "openapi:generate": "openapi-ts",
    "codegen": "npm run openapi:normalize && npm run openapi:generate",
    "codegen:check": "npm run codegen && git diff --exit-code -- src/generated build/foreca.normalized.json"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.100",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "2.1.9"
  }
}
